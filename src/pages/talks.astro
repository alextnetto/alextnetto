---
import Base from '../layouts/Base.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { getCollection, render } from 'astro:content';

const copy = {
  pt: {
    htmlLang: 'pt-BR',
    heading: 'Palestras',
    intro: 'Palestras que eu levo para eventos, empresas, universidades e associações. Clique no título para ver o conteúdo de cada uma.',
    bio: 'Sou fundador e CEO da blockful, empresa de segurança e infraestrutura, e estou construindo a Fator, que coloca agentes de IA para funcionar dentro de empresas brasileiras. Palestrei duas vezes em Stanford sobre uma pesquisa de cibersegurança, em 2025 e em 2026. Também já falei em eventos no Brasil, nos Estados Unidos, na Suíça, na Turquia e na Espanha, e em empresas dos Estados Unidos à América Latina.',
    ctaStart: 'Quer uma dessas palestras no seu evento?',
    form: 'Preencha o formulário de contato',
    or: 'ou me chame no',
    and: 'ou no',
    ctaEnd: 'Duração e profundidade se ajustam ao público, em português ou em inglês.',
  },
  en: {
    htmlLang: 'en',
    heading: 'Talks',
    intro: 'Talks I give at conferences, companies, universities and associations. Click a title to see what each one covers.',
    bio: 'I am the founder and CEO of blockful, a security and infrastructure company, and I am building Fator, which puts AI agents to work inside Brazilian companies. I have spoken twice at Stanford about cybersecurity research, in 2025 and 2026. I have also spoken at events in Brazil, the United States, Switzerland, Turkey and Spain, and at companies from the US to Latin America.',
    ctaStart: 'Want one of these talks at your event?',
    form: 'Fill in the contact form',
    or: 'or reach me on',
    and: 'or',
    ctaEnd: 'Length and depth adapt to the audience, in English or Portuguese.',
  },
} as const;

const langs = ['pt', 'en'] as const;
const talks = await getCollection('talks');

const sections = await Promise.all(
  langs.map(async (lang) => ({
    lang,
    items: await Promise.all(
      talks
        .filter((talk) => talk.id.startsWith(`${lang}/`))
        .sort((a, b) => a.data.order - b.data.order)
        .map(async (talk) => ({ title: talk.data.title, Content: (await render(talk)).Content }))
    ),
  }))
);
---

<Base title="Talks by Alex Netto" description="Three talks I give at events and companies: Service-as-Software, two months in Silicon Valley, and the risks of AI. In Portuguese or English.">
  <LangSwitch>
    <h1>
      {langs.map((lang) => <span data-lang-block={lang}>{copy[lang].heading}</span>)}
    </h1>
  </LangSwitch>

  {sections.map(({ lang, items }) => (
    <div data-lang-block={lang} lang={copy[lang].htmlLang}>
      <p class="talks-intro">{copy[lang].intro}</p>
      <p class="talks-bio">{copy[lang].bio}</p>

      <div class="talk-list">
        {items.map(({ title, Content }) => (
          <details class="talk">
            <summary>{title}</summary>
            <div class="talk-body">
              <Content />
            </div>
          </details>
        ))}
      </div>

      <p class="talks-cta">
        {copy[lang].ctaStart} <a href={`/contact?type=talk&lang=${lang}`}>{copy[lang].form}</a> {copy[lang].or} <a href="https://www.linkedin.com/in/alextnetto" target="_blank" rel="noopener noreferrer">LinkedIn</a> {copy[lang].and} <a href="https://t.me/alextnetto" target="_blank" rel="noopener noreferrer">Telegram</a>. {copy[lang].ctaEnd}
      </p>
    </div>
  ))}
</Base>
