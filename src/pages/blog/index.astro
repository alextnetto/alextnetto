---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base title="Blog — Alexandro Netto" description="Writing about mechanism design, public goods, governance, and the Ethereum ecosystem.">
  <h1>Blog</h1>

  {posts.length === 0 && <p>No posts yet.</p>}

  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <span class="post-list-date">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        </span>
        <a href={`/blog/${post.id}`} class="post-list-title">{post.data.title}</a>
        {post.data.description && (
          <p style="margin: 0.25rem 0 0; font-size: 0.9rem; color: var(--text-secondary);">
            {post.data.description}
          </p>
        )}
      </li>
    ))}
  </ul>
</Base>
