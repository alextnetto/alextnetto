---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<Base>
  <div class="hero">
    <div class="hero-text">
      <h1>Alex Netto</h1>
      <p class="tagline">Working at the intersection of game theory, economy, and bytes.</p>
    </div>
    <!-- Crossfades every 6 s in CSS; reduced motion shows the first photo only. -->
    <div class="hero-photos">
      <img src="/photos/fator.webp" width="1000" height="1000" alt="Alex Netto on stage, wearing a Fator AI t-shirt" fetchpriority="high" />
      <img src="/photos/stanford.webp" width="1000" height="1000" alt="Alex Netto speaking at the Stanford Blockchain Governance Summit" decoding="async" />
      <img src="/photos/monte-carlo.webp" width="1000" height="1000" alt="Alex Netto in the stands at the Monte-Carlo Masters" decoding="async" />
      <img src="/photos/meetup.webp" width="1000" height="1000" alt="Alex Netto in a group selfie at a builders meetup" decoding="async" />
      <img src="/photos/triathlon.webp" width="1000" height="1000" alt="Alex Netto running a triathlon" decoding="async" />
      <img src="/photos/ens-talk.webp" width="1000" height="1000" alt="Alex Netto giving a talk in an ENS t-shirt" decoding="async" />
    </div>
  </div>

  <section class="section">
    <h2>About</h2>
    <p>
      Born in Germany, raised in Brazil. Coding since 14 and working as a software engineer since 2019: 7+ years spanning fintech infrastructure, security, AI agents, and product leadership. I founded and run <strong>blockful</strong>, a security and infrastructure company with a senior team of 10, and I am building <strong>Fator</strong>, which puts AI agents to work inside Brazilian companies. Invited speaker at Stanford twice. Former competitive basketball player, now training for an Ironman; sports taught me discipline and high agency. I speak Portuguese, English, Spanish, and German.
    </p>
    <p>
      <a href="https://ncase.me/trust/">Optimism</a>, courage, and integrity are my core values.
    </p>
  </section>

  <section class="section">
    <h2>Now</h2>
    <ul>
      <li>Building <strong>Fator</strong>: AI agents working inside Brazilian companies</li>
      <li>CEO & Founder at <strong>blockful</strong>: security and infrastructure</li>
      <li>ENS Delegate and Security Council member</li>
      <li>Researching mechanism design, governance, and public goods funding</li>
    </ul>
  </section>

  <section class="section">
    <h2>Work with me</h2>
    <ul>
      <li><strong>Talks</strong> in English or Portuguese. Suggested topics: Service-as-Software, AI risks and what I learned in Silicon Valley, adapted to the needs and interests of your audience. <a href="/talks">See the talks</a>.</li>
      <li><strong>Advisor in technology and AI</strong> for founders and executives deciding where to start with AI, what to buy and what to build.</li>
      <li><strong>AI in your company</strong>: my team and I put AI agents to work in the systems your team already uses.</li>
    </ul>
    <p><a href="/contact">Get in touch through the contact form</a>.</p>
  </section>

  <section class="section">
    <h2>Experience</h2>

    <div class="project-item">
      <strong>CEO & Founder, blockful</strong>
      <p>Founded a security and infrastructure company. Grew to 18 people, strategically consolidated to a senior team of 10. Directly sold $5M+ in services and software solutions. Three engagements with Brazil's Central Bank on CBDC programs. Organized event at B3 (Brazilian Stock Exchange) with DREX leadership. Co-designed a BRL-backed stablecoin architecture with Chainlink, Stark Bank, and Genial Investimentos. In 2026 we started Fator inside blockful, moving from security to putting AI agents to work in Brazilian companies.</p>
    </div>

    <div class="project-item">
      <strong>CTO, Ayla</strong>
      <p>Led a team of 4 at a real estate startup. Built proptech tools that drove a 70% increase in company revenue. Full ownership of technical strategy, product architecture, and delivery.</p>
    </div>

    <div class="project-item">
      <strong>Senior Backend Engineer, Bava</strong>
      <p>Built backend systems for a B2B financial services platform.</p>
    </div>

    <div class="project-item">
      <strong>Full-Stack Engineer, TecBan</strong>
      <p>Developed solutions for one of Brazil's largest financial infrastructure providers, which operates the Banco24Horas ATM network serving 150M+ transactions/year.</p>
    </div>
  </section>

  <section class="section">
    <h2>Open Source & Contributions</h2>

    <div class="achievement-group">
      <h3>Projects</h3>

      <div class="project-item">
        <strong><a href="https://github.com/alextnetto/res">RES</a></strong>
        <p>Agent skill that reverse engineers a SaaS product through the browser into a build kit: screens, business rules with evidence, data model, design tokens and launch barriers, without touching production data. Includes public studies of ClickUp and Pipedrive.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/blockful/anticapture">anticapture</a></strong>
        <p>Governance monitoring platform. Built Arkham address enrichment, voting infrastructure, activity feeds, and per-DAO event thresholds.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/blockful/dao-proposals">dao-proposals</a></strong>
        <p>ENS governance proposal review framework. Calldata decoding, verification, and security analysis for on-chain proposals to the ENS DAO.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/alextnetto/deadman-switch-safe">deadman-switch-safe</a></strong>
        <p>Dead man's switch module for Gnosis Safe: automatic asset recovery if the owner becomes inactive.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/alextnetto/vaultr">vaultr</a></strong>
        <p>Secure personal data sharing with expiring links.</p>
      </div>

    </div>

    <div class="achievement-group">
      <h3>Contributions</h3>

      <div class="project-item">
        <strong><a href="https://paragraph.com/@blockful/a-hidden-threat-to-ens-uncovering-and-solving-a-major-governanc">ENS governance vulnerability</a></strong>
        <p>Discovered and responsibly disclosed a vulnerability that could have enabled a ~$150M attack on ENS DAO governance.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://eips.ethereum.org/EIPS/eip-7884">ERC-7884: Operation Router</a></strong>
        <p>Co-authored Ethereum standard enabling smart contracts to redirect write operations to L2 chains, L1, or off-chain databases.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/metagov/daostar/blob/main/DAOIPs/daoip-6.md">DAOIP-6</a></strong>
        <p>Co-authored a DAO interoperability standard for grant program reporting via Metagov/DAOstar.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/safe-global/safe-wallet-monorepo/pull/7124">Safe&#123;Wallet&#125;</a></strong>
        <p>Added ENS name resolution to account list items. Merged into the main Safe smart account wallet.</p>
      </div>

      <div class="project-item">
        <strong><a href="https://github.com/steipete/gogcli/pull/263">gogcli</a></strong>
        <p>Added <code>docs comments</code> subcommand for managing Google Doc comments to this Google Suite CLI tool.</p>
      </div>

    </div>
  </section>

  <section class="section">
    <h2>Speaking & Teaching</h2>
    <ul>
      <li><strong><a href="https://www.youtube.com/watch?v=RyEVflEF_qY">Stanford University</a></strong>: invited speaker on security research (2025 and 2026)</li>
      <li>ETH Denver 2023, SmartCon 2023: bootcamp instructor</li>
      <li>Federal University of Paraná: blockchain fundamentals bootcamp</li>
      <li>ENS Workshop at ETH Samba</li>
      <li>Speaker at conferences across Brazil, US (Denver, SF, NYC), Switzerland, Turkey, and Spain</li>
      <li>Talks at companies from the US to Latin America</li>
    </ul>
  </section>

  <section class="section">
    <h2>Awards</h2>

    <div class="achievement-group">
      <h3>Academic</h3>
      <ul>
        <li>State Math Olympiad: gold medal</li>
        <li>Brazilian National Math Olympiad: silver medal</li>
      </ul>
    </div>

    <div class="achievement-group">
      <h3>Hackathons: 15+ prizes in 50+ competitions</h3>
      <ul>
        <li>ETH Belgrade 2024: 1st place, largest prize</li>
        <li>ETHGlobal Brussels: Uniswap + Pancakeswap prizes</li>
        <li>SmartCon 2023: 1st place, Chainlink Functions</li>
        <li>ETH Rio 2023: 2 categories, AI delegates</li>
        <li>ETHGlobal NYC: 2 category prizes</li>
        <li>ETH Samba 2023: 3 category prizes</li>
        <li>ETH São Paulo 2022: grand prize</li>
        <li>ETH Rio 2022: 1st place, DeFi</li>
        <li>NASA SpaceApps: 1st place</li>
        <li>AutTech Hackathon: 1st place</li>
      </ul>
    </div>
  </section>

  <section class="section">
    <h2>Community</h2>
    <ul>
      <li>Organized <strong>ETHFloripa</strong>, <strong>ZuFloripa</strong>, and frENS hour @ Devconnect 2023</li>
      <li>Event at B3 headquarters with Brazil's CBDC director</li>
      <li>Kernel Fellow, Chainlink Developer Expert, Zuzalian</li>
      <li>ENS & Chainlink meetup @ ETH Belgrade</li>
      <li>My team organized Brazil's first OpenClaw meetup</li>
    </ul>
  </section>

  <section class="section">
    <h2>Education</h2>
    <p>
      Computer Science at the Federal University of Santa Catarina (UFSC), Florianópolis, Brazil. I left after 3 years to start blockful.
    </p>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <h2>Writing</h2>
      <ul class="post-list">
        {posts.map((post) => (
          <li>
            <span class="post-list-date">
              {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
            </span>
            <a href={`/blog/${post.id}`} class="post-list-title">{post.data.title}</a>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>
