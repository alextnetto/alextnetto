---
import Base from './Base.astro';
import Bi from '../components/Bi.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
  readingTime?: string;
}

const { title, date, description, readingTime } = Astro.props;

const formattedDate = (locale: string) =>
  date.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
---

<Base title={`${title} | Alexandro Netto`} description={description || title}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}><Bi en={formattedDate('en-US')} pt={formattedDate('pt-BR')} /></time>
        {readingTime && <span>{readingTime}</span>}
      </div>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Base>
