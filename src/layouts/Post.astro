---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
  readingTime?: string;
}

const { title, date, description, readingTime } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Base title={`${title} — Alexandro Netto`} description={description || title}>
  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="post-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        {readingTime && <span>{readingTime}</span>}
      </div>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
</Base>
